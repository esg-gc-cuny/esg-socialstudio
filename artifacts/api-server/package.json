{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:stateless": "esbuild src/routes/research-social/stateless.test.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=/tmp/esg-stateless-tests.mjs && node --test /tmp/esg-stateless-tests.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:social-posts": "esbuild src/lib/platform-post-generation.test.ts --bundle --platform=node --format=esm --outfile=/tmp/esg-social-post-tests.mjs && node --test /tmp/esg-social-post-tests.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^1.52.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "openai": "^6.49.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
